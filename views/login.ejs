<!DOCTYPE html>
<html>

<head>
    <title>Login</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="auth-page">

    <div class="navbar">
        <h2>AI Tutoring Study Helper</h2>

        <div>
            <a href="/">Home</a>
            <a href="/signup">Signup</a>
        </div>
    </div>

    <div class="container">

        <div class="card">

            <h1>Login</h1>

            <p>Login to continue using your AI Tutoring Study Helper.</p>

            <form class="form-box" action="/login" method="POST">

                <input
                    type="email"
                    name="email"
                    placeholder="Email"
                    required
                >

                <input
                    type="password"
                    name="password"
                    placeholder="Password"
                    required
                >

                <button class="btn" type="submit">
                    Login
                </button>

            </form>

        </div>

    </div>

<body class="auth-page">
</html>